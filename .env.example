# Copy to .env and fill in real values. NEVER commit .env to git.
# .env is gitignored and blocked by .ai/hooks/guard-env-files.py.
#
# Variable | Purpose | Required | Default
# ---------|---------|----------|--------
# APP_LOG_LEVEL | Logging verbosity | No | INFO
# APP_PORT | HTTP listen port | No | 8080
# APP_ENV | Environment name (local/staging/prod) | No | local
# DATABASE_URL | Local placeholder / production private platform bindable | Yes (runtime) | —
# VALKEY_URL | Local placeholder / production private platform bindable | Yes (runtime) | —
# SPACES_ENDPOINT | Spaces API endpoint | Yes (runtime) | —
# SPACES_BUCKET | Private bucket for contract PDFs | Yes (runtime) | —
# SPACES_REGION | Spaces region | Yes (runtime) | —
# SPACES_CREDENTIALS_JSON | Versioned Spaces runtime secret JSON | Yes (runtime) | —
# PRESIGNED_URL_TTL_SECONDS | Default GET-only signed URL lifetime | No | 3600
# PRESIGNED_URL_MAX_TTL_SECONDS | Maximum signed URL lifetime | No | 86400
# LLM_BASE_URL | DigitalOcean Serverless Inference base URL | Yes (Part 1) | https://inference.do-ai.run
# LLM_CREDENTIALS_JSON | Versioned inference runtime secret JSON | Yes (Part 1) | —
# LLM_MODEL | Model id from the DO catalog | No | (choose any available)
# WORKER_CONCURRENCY | Max simultaneous jobs per worker | No | 2
# INFERENCE_MAX_CONCURRENCY | Provisional fleet-wide inference cap | No | 10
# INFERENCE_TIMEOUT_SECONDS | Hard cap on model call hang | No | 240
# JOB_MAX_RETRIES | Retries after the initial attempt | No | 3
# JOB_LEASE_SECONDS | Worker claim lease | No | 570
# RECONCILE_INTERVAL_SECONDS | Ledger reconciliation interval | No | 60
# RECONCILE_BATCH_SIZE | Maximum jobs per reconciliation cycle | No | 100
# WORKER_GRACE_PERIOD_SECONDS | Worker shutdown/drain grace | No | 600
# UPLOAD_MAX_BYTES | Maximum accepted PDF bytes | No | 26214400
# UPLOAD_SCAN_REQUIRED | Require malware scan before enqueue | No | false
# SIMULATION_SEED | Deterministic staging/test fault seed | No | 0
# AUTH_MODE | local fake issuer or fail-closed adapter | No | local
# SIMULATED_TIMEOUT_RATE | Staging/test timeout probability | No | 0
# SIMULATED_FAILURE_RATE | Staging/test failure probability | No | 0
# SIM_WORK_MIN_SECONDS | Minimum simulated work sleep | No | 20
# SIM_WORK_MAX_SECONDS | Maximum simulated work sleep | No | 240

# Application
APP_LOG_LEVEL=INFO
APP_PORT=8080
APP_ENV=local

# Managed data (local placeholders; production uses private platform bindables)
DATABASE_URL=postgresql://USER:PASSWORD_PLACEHOLDER@HOST:25060/halcyon?sslmode=require
VALKEY_URL=rediss://default:PASSWORD_PLACEHOLDER@HOST:25061

# Object storage (Spaces)
SPACES_ENDPOINT=https://REGION.digitaloceanspaces.com
SPACES_BUCKET=halcyon-contracts-PLACEHOLDER
SPACES_REGION=nyc3
SPACES_CREDENTIALS_JSON='{"schema_version":1,"environment":"local","access_key":"SPACES_KEY_PLACEHOLDER","secret_key":"SPACES_SECRET_PLACEHOLDER"}'
PRESIGNED_URL_TTL_SECONDS=3600
PRESIGNED_URL_MAX_TTL_SECONDS=86400

# DigitalOcean Serverless Inference (OpenAI-compatible)
# Docs: https://docs.digitalocean.com/products/inference/
LLM_BASE_URL=https://inference.do-ai.run
LLM_CREDENTIALS_JSON='{"schema_version":1,"environment":"local","api_key":"INFERENCE_TOKEN_PLACEHOLDER"}'
LLM_MODEL=your-model-id

# Worker / resilience
WORKER_CONCURRENCY=2
INFERENCE_MAX_CONCURRENCY=10
INFERENCE_TIMEOUT_SECONDS=240
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=570
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_BATCH_SIZE=100
WORKER_GRACE_PERIOD_SECONDS=600
UPLOAD_MAX_BYTES=26214400
UPLOAD_SCAN_REQUIRED=false
AUTH_MODE=local

# Controlled faults: keep rates at zero outside tests/staging.
SIMULATION_SEED=0
SIMULATED_TIMEOUT_RATE=0
SIMULATED_FAILURE_RATE=0
SIM_WORK_MIN_SECONDS=20
SIM_WORK_MAX_SECONDS=240

