# SPDX-License-Identifier: MIT
# Non-secret production values for local .env / App Spec fill after Terraform apply.
# SECRETS stay out of this file — put these only in gitignored .env or App Platform SECRET:
#   DATABASE_URL, VALKEY_URL, SPACES_CREDENTIALS_JSON, LLM_CREDENTIALS_JSON, DIGITALOCEAN_TOKEN
#
# Usage:
#   1. After production apply, replace REPLACE_* from terraform output / doctl
#   2. Copy non-secret keys into .env (never commit filled secrets)
#   3. Deploy via deploy/app-spec.production.yaml + SECRET injection
#
# Prep-authorized defaults (see docs/operations/production-prep.md):
#   APP_ENV=production, AUTH_MODE=fail_closed, scan off until checklist §E,
#   inference caps from A-WORK-04, HA sizing from production.tfvars.example.

# --- Application ---
APP_LOG_LEVEL=INFO
APP_PORT=8080
APP_ENV=production
AUTH_MODE=fail_closed

# --- Production resource IDs / URLs (fill after apply) ---
HALCYON_PROJECT_ID=REPLACE_PROJECT_ID
HALCYON_VPC_ID=REPLACE_VPC_ID
HALCYON_POSTGRES_ID=REPLACE_POSTGRES_ID
HALCYON_VALKEY_ID=REPLACE_VALKEY_ID
HALCYON_APP_ID=REPLACE_APP_ID
HALCYON_LIVE_URL=REPLACE_LIVE_URL
HALCYON_REGISTRY=REPLACE_REGISTRY
HALCYON_REGISTRY_ENDPOINT=registry.digitalocean.com/REPLACE_REGISTRY
HALCYON_IMAGE_REPOSITORY=halcyon-sim
HALCYON_IMAGE_TAG=REPLACE_DIGEST_OR_TAG

# --- Managed data hosts (non-secret; passwords only in DATABASE_URL / VALKEY_URL) ---
HALCYON_PG_HOST=REPLACE_PG_HOST
HALCYON_PG_PRIVATE_HOST=REPLACE_PG_PRIVATE_HOST
HALCYON_PG_PORT=25060
HALCYON_PG_DB=defaultdb
HALCYON_PG_USER=doadmin
HALCYON_VK_HOST=REPLACE_VK_HOST
HALCYON_VK_PRIVATE_HOST=REPLACE_VK_PRIVATE_HOST
HALCYON_VK_PORT=25061
HALCYON_VK_USER=default

# --- Spaces / inference (non-secret) ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=REPLACE_SPACES_BUCKET
SPACES_REGION=nyc3
PRESIGNED_URL_TTL_SECONDS=3600
PRESIGNED_URL_MAX_TTL_SECONDS=86400
LLM_BASE_URL=https://inference.do-ai.run
LLM_MODEL=REPLACE_MODEL_ID

# --- Worker / resilience (production App Spec defaults) ---
WORKER_CONCURRENCY=2
INFERENCE_MAX_CONCURRENCY=10
INFERENCE_TIMEOUT_SECONDS=240
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=570
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_BATCH_SIZE=100
WORKER_GRACE_PERIOD_SECONDS=600
UPLOAD_MAX_BYTES=26214400
UPLOAD_SCAN_REQUIRED=false
SIMULATION_SEED=0
SIMULATED_TIMEOUT_RATE=0
SIMULATED_FAILURE_RATE=0

# --- Terraform / App Spec fill helpers ---
TF_PROJECT_NAME=halcyon-part1-production
TF_REGION=nyc3
TF_VPC_IP_RANGE=10.30.0.0/24
APP_PLATFORM_REGION=nyc
SPACES_BUCKET_DOMAIN=REPLACE_SPACES_BUCKET.nyc3.digitaloceanspaces.com
