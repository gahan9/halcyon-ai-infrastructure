# Non-secret staging values for local .env / App Spec fill.
# SECRETS stay out of this file — put these only in gitignored .env or App Platform SECRET:
#   DATABASE_URL, VALKEY_URL, SPACES_CREDENTIALS_JSON, LLM_CREDENTIALS_JSON, DIGITALOCEAN_TOKEN
#
# Usage:
#   1. Copy non-secret keys below into .env (or run: python scripts/merge_nonsecret_env.py)
#   2. Fill secret placeholders in .env from: doctl databases connection <id>
#   3. For App Platform redeploy, use deploy/app-spec.staging.yaml + SECRET injection

# --- Application ---
APP_LOG_LEVEL=INFO
APP_PORT=8080
# Live staging app currently uses local/fake for smoke; versioned App Spec wants staging/fail_closed.
APP_ENV=local
AUTH_MODE=local

# --- Staging resource IDs / URLs (non-secret) ---
